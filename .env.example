# Copy to .env.local and fill in. Never commit real values.
# Same variables as the Next.js app (ai-cost-tracker), so one .env.local works for both.

# --- LangSmith (read traces exported by VS Code Copilot Chat) ---
# Personal API key: LangSmith UI -> Settings -> API Keys
LANGSMITH_API_KEY=
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Must match the `Langsmith-Project=` value in OTEL_EXPORTER_OTLP_HEADERS
LANGSMITH_PROJECT=copilot-vscode
# Only needed if the key has access to several workspaces (sent as X-Tenant-Id)
LANGSMITH_WORKSPACE_ID=

# --- GitHub (issues / PRs / commits, read-only) ---
# Fine-grained PAT, read-only: Issues, Pull requests, Metadata.
# Optional for the app's Sync button: without it, the `gh auth token` session is used.
GITHUB_TOKEN=

# --- Local SQLite ---
# Default: ./data/app.db (keep commented out unless you need another path; an empty
# value would be used as-is)
# DB_PATH=./data/app.db
